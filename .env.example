########################################
# Environment configuration for project
########################################

# OpenAI API key used by LangChain components (RAG, agents, chains).
# Get one from: https://platform.openai.com/api-keys
# Then copy this file to `.env` and replace the placeholder value below.
OPENAI_API_KEY=sk-REPLACE_ME_WITH_YOUR_KEY

# Optional: override default OpenAI organization if you use it
# OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxxxxxx

# If you add other providers (Anthropic, Google, etc.), document them here, e.g.:
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

